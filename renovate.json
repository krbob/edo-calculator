{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>krbob/renovate-config:monthly"
  ],
  "rangeStrategy": "pin",
  "pinDigests": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "val jibBaseImage\\s*=\\s*\"(?<depName>[^\"@]+):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the pinned distroless Java 21 nonroot flavor",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "gcr.io/distroless/java21-debian13"
      ],
      "allowedVersions": "/^nonroot$/"
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
